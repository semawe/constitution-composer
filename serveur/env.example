# Service des comptes du Constitution Composer — variables d'environnement.
# Noms seulement : les valeurs vivent dans le coffre Bitwarden de l'organisation
# Sémawé et dans le fichier d'environnement de l'unité systemd (lot 3).

# Origine publique du site et du service (HTTPS hors développement local).
APP_ORIGIN=https://constitution-composer.com

# Rôle applicatif (sans contournement de la sécurité par ligne) et rôle
# propriétaire (migrations et import uniquement).
DATABASE_URL=postgresql://composer_app:…@127.0.0.1:5432/composer
DATABASE_MIGRATION_URL=postgresql://composer_owner:…@127.0.0.1:5432/composer

# Clés HMAC du cookie d'état Google : base64url, 32 octets au moins, séparées
# par des virgules ; la première signe, toutes vérifient (rotation).
COMPOSER_SECRETS=

# Connexion Google (client OAuth web ; retour : <APP_ORIGIN>/api/connexion/google/retour).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Liens de connexion par courriel : API transactionnelle Brevo.
BREVO_API_KEY=
EMAIL_FROM=connexion@constitution-composer.com
EMAIL_FROM_NAME=Constitution Composer

# Nouvelles du Composer : identifiant de la liste Brevo « Composer — inscrits »
# (215, compte Sémawé). Vide : aucun consentement n'est transmis à Brevo.
BREVO_LISTE_INSCRITS=

# Webhook entrant Slack du canal #constitution-composer-utilisateurs (facultatif).
SLACK_WEBHOOK_URL=

# Manifeste des releases du fond (par défaut : ../src/data/releases/manifest.json).
RELEASES_MANIFEST=

# Écoute (derrière nginx).
HOST=127.0.0.1
PORT=3100
