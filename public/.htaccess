# constitution-composer.com — hébergement mutualisé OVH (Apache, statique).

# Pas de listing de répertoire. DirectorySlash est désactivé pour que les URL
# exportées restent canoniques sans slash final avant la réécriture du point 3.
Options -Indexes
DirectorySlash Off

RewriteEngine On

# 0. Hôte canonique : tout hôte autre que l'apex .com (www, .fr en multisite…)
#    redirige vers lui en une seule étape, https compris.
RewriteCond %{HTTP_HOST} !^constitution-composer\.com$ [NC]
RewriteRule ^ https://constitution-composer.com%{REQUEST_URI} [L,R=301]

# 1. Forcer HTTPS.
#    Sur le mutualisé OVH la terminaison TLS est faite par un proxy : le backend
#    voit toujours http, donc on détecte le protocole d'origine via l'en-tête
#    X-Forwarded-Proto (utiliser %{HTTPS} provoquerait une boucle de redirection).
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. URLs canoniques : sans extension .html ni slash final.
#    Ces redirections ne se déclenchent que sur la requête réelle du navigateur
#    (THE_REQUEST), pas sur les réécritures internes du point 3 → pas de boucle.

#    URL absolue avec %{HTTP_HOST} pour éviter un « :443 » parasite dans Location.
#    /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]

#    /chemin.html -> /chemin
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

#    /chemin/ -> /chemin (retrait du slash final, racine exceptée)
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3. Service des URLs sans extension : si /chemin n'est pas un fichier mais que
#    /chemin.html existe, on le sert en réécriture interne (l'URL reste propre).
#    Réécrire ici neutralise aussi le DirectorySlash de mod_dir (la cible .html
#    est un fichier, donc pas de redirection parasite vers une URL avec slash).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 4. Page 404 statique générée par Next.
ErrorDocument 404 /404.html

# 5. En-têtes de sécurité et cache.
<IfModule mod_headers.c>
  # HSTS uniquement quand la requête d'origine est en HTTPS (proxy TLS OVH).
  SetEnvIf X-Forwarded-Proto https HTTPS_ON
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS_ON

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Content-Security-Policy. L'enjeu principal : la session Supabase vit dans le
  # stockage local, donc lisible par tout script de la page — un script tiers
  # compromis pourrait l'exfiltrer, y compris celle d'un administrateur. La CSP
  # ferme les destinations : seuls Supabase et Umami sont joignables, et aucun
  # script ne peut être chargé depuis une autre origine.
  # `unsafe-inline` sur script-src reste nécessaire : Next.js sème des scripts
  # inline de sérialisation (self.__next_f) dont le contenu varie à chaque
  # build, ce qui exclut une liste de hachages tenable en export statique.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; connect-src 'self' https://zzebhtyvbzfnfrjhqiia.supabase.co wss://zzebhtyvbzfnfrjhqiia.supabase.co https://cloud.umami.is https://gateway.umami.is; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Assets Next hashés : cache long immuable.
  SetEnvIf Request_URI ^/_next/static/ NEXT_STATIC
  Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_STATIC
</IfModule>
