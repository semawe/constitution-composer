# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

# Accounts backend, chosen at build time:
#   NEXT_PUBLIC_BACKEND=serveur   the accounts service on the same origin, under /api (Sémawé instance)
#   NEXT_PUBLIC_BACKEND=supabase  Supabase (default when the two keys below are set)
#   NEXT_PUBLIC_BACKEND=demo      no backend, simulated account in the browser
# A production build without a backend fails unless NEXT_PUBLIC_ALLOW_DEMO_MODE=true.
NEXT_PUBLIC_BACKEND=

# Supabase project credentials (only for NEXT_PUBLIC_BACKEND=supabase)
# Create a free project at https://supabase.com, then find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Coaches offered for booking (optional — leave blank to hide the booking section).
# JSON array of { "name", "url" } — url is a public booking page (e.g. Google Calendar).
# NEXT_PUBLIC_COACHES=[{"name":"Jane","url":"https://calendar.app.google/xxxx"}]
NEXT_PUBLIC_COACHES=

# Umami analytics (optional — leave blank to disable)
# https://umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
